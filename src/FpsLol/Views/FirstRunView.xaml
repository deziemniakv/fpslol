<UserControl x:Class="FpsLol.Views.FirstRunView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:FpsLol.Controls">
    <Grid>
        <Border Style="{StaticResource Card}" Background="{StaticResource Brush.GlassStrong}" Width="580" Padding="40,38" CornerRadius="26"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="60" ShadowDepth="18" Direction="270" Opacity="0.5" Color="Black" />
            </Border.Effect>
            <Grid>
                <!-- ================================================ Step 0: welcome -->
                <c:PageHost Visibility="{Binding Step, Converter={StaticResource EqualsToVisibility}, ConverterParameter=0}" Content="{Binding}">
                    <c:PageHost.ContentTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="FPS" FontFamily="{StaticResource Font.Display}" FontSize="44" FontWeight="Bold" />
                                    <TextBlock Text=".LOL" FontFamily="{StaticResource Font.Display}" FontSize="44" FontWeight="Bold" Foreground="{StaticResource Brush.TextTertiary}" />
                                </StackPanel>
                                <TextBlock Text="Optimize. Play. Perform." Style="{StaticResource Text.Secondary}" HorizontalAlignment="Center" Margin="0,4,0,30" />
                                <TextBlock Text="Welcome to FPS.LOL" Style="{StaticResource Text.H2}" HorizontalAlignment="Center" />
                                <TextBlock Style="{StaticResource Text.Secondary}" TextAlignment="Center" Margin="0,10,0,0"
                                           Text="FPS.LOL tunes real Windows settings for smoother frame times, lower background load and a cleaner network path. Nothing changes without your confirmation, every change is verified, and everything can be restored." />
                                <UniformGrid Columns="3" Margin="0,26,0,30">
                                    <StackPanel Margin="4">
                                        <c:IconView Data="{StaticResource Icon.ShieldCheck}" Width="20" Height="20" Foreground="{StaticResource Brush.TextSecondary}" />
                                        <TextBlock Text="Backup first" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                                    </StackPanel>
                                    <StackPanel Margin="4">
                                        <c:IconView Data="{StaticResource Icon.CircleCheck}" Width="20" Height="20" Foreground="{StaticResource Brush.TextSecondary}" />
                                        <TextBlock Text="Verified changes" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                                    </StackPanel>
                                    <StackPanel Margin="4">
                                        <c:IconView Data="{StaticResource Icon.RotateCcw}" Width="20" Height="20" Foreground="{StaticResource Brush.TextSecondary}" />
                                        <TextBlock Text="Restore anytime" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                                    </StackPanel>
                                </UniformGrid>
                                <Button Style="{StaticResource Btn.Primary}" Command="{Binding StartCommand}" HorizontalAlignment="Center" Padding="28,11">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Start system scan" />
                                        <c:IconView Data="{StaticResource Icon.ArrowRight}" Width="15" Height="15" Margin="8,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource Btn.Link}" Command="{Binding SkipCommand}" HorizontalAlignment="Center" Margin="0,14,0,0">
                                    <TextBlock Text="Skip for now" />
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </c:PageHost.ContentTemplate>
                </c:PageHost>

                <!-- ================================================ Step 1: scanning -->
                <StackPanel Visibility="{Binding Step, Converter={StaticResource EqualsToVisibility}, ConverterParameter=1}">
                    <TextBlock Text="System Scan" Style="{StaticResource Text.H1}" />
                    <TextBlock Text="Detecting hardware and reading gaming-related settings. Nothing is changed." Style="{StaticResource Text.Secondary}" Margin="0,6,0,22" />
                    <ItemsControl ItemsSource="{Binding Steps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource IconTile}" Width="32" Height="32" CornerRadius="10">
                                        <c:IconView Data="{Binding Icon, Converter={StaticResource ResourceKey}}" Width="15" Height="15" Foreground="{StaticResource Brush.TextSecondary}" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding Label}" Margin="12,0,0,0" VerticalAlignment="Center" FontWeight="Medium" />
                                    <TextBlock Grid.Column="2" Text="{Binding Value}" Style="{StaticResource Text.Secondary}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <Grid Grid.Column="3" Width="18" Height="18">
                                        <c:Spinner Width="16" Height="16" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                                        <c:IconView Data="{StaticResource Icon.CircleCheck}" Width="18" Height="18" Foreground="{StaticResource Brush.Success}"
                                                    Visibility="{Binding IsDone, Converter={StaticResource BoolToVisibility}}" />
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- ================================================ Step 2: result -->
                <c:PageHost Visibility="{Binding Step, Converter={StaticResource EqualsToVisibility}, ConverterParameter=2}" Content="{Binding}">
                    <c:PageHost.ContentTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="Your system score" Style="{StaticResource Text.Overline}" HorizontalAlignment="Center" />
                                <Grid Width="180" Height="180" Margin="0,16,0,14">
                                    <c:ScoreRing Value="{Binding Score}" Thickness="11" />
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Score}" Style="{StaticResource Text.Display}" HorizontalAlignment="Center" />
                                        <TextBlock Text="/ 100" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" Margin="0,-6,0,0" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding Headline}" Style="{StaticResource Text.H2}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,28">
                                    <TextBlock Text="Available optimizations:" Style="{StaticResource Text.Secondary}" />
                                    <TextBlock Text="{Binding AvailableCount}" FontWeight="SemiBold" Margin="6,0,0,0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Style="{StaticResource Btn.Glass}" Content="VIEW OPTIMIZATIONS" Command="{Binding ViewOptimizationsCommand}" Padding="20,11" Margin="0,0,10,0" />
                                    <Button Style="{StaticResource Btn.Primary}" Command="{Binding OptimizeNowCommand}" Padding="22,11">
                                        <StackPanel Orientation="Horizontal">
                                            <c:IconView Data="{StaticResource Icon.Zap}" Width="15" Height="15" Margin="0,0,8,0" />
                                            <TextBlock Text="OPTIMIZE NOW" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <TextBlock Text="You will review every change before anything is applied." Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" Margin="0,16,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </c:PageHost.ContentTemplate>
                </c:PageHost>
            </Grid>
        </Border>
    </Grid>
</UserControl>
