<UserControl x:Class="FpsLol.Views.Pages.PowerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:FpsLol.Controls">
    <ScrollViewer Style="{StaticResource PageScroll}">
        <StackPanel MaxWidth="1100">
            <StackPanel Margin="0,0,0,22">
                <TextBlock Text="Power" Style="{StaticResource Text.H1}" />
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Secondary}" Margin="0,4,0,0" />
            </StackPanel>

            <Border Style="{StaticResource Card}" Padding="28,26" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconTile}" Width="52" Height="52" CornerRadius="16" VerticalAlignment="Top">
                        <c:IconView Data="{StaticResource Icon.Power}" Width="24" Height="24" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="20,0,0,0">
                        <TextBlock Text="Active power plan" Style="{StaticResource Text.Overline}" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="{Binding ActiveName}" Style="{StaticResource Text.H1}" FontSize="24" />
                            <Border Style="{StaticResource Badge}" Margin="12,0,0,0" Background="{Binding ActiveIsPerformance, Converter={StaticResource ToneSoftBrush}}">
                                <TextBlock Text="{Binding ActivePersonality}" Style="{StaticResource Badge.Text}" Foreground="{Binding ActiveIsPerformance, Converter={StaticResource ToneBrush}}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding DeviceText}" Style="{StaticResource Text.Secondary}" Margin="0,6,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                            <Button Style="{StaticResource Btn.Primary}" Command="{Binding ApplyGamingProfileCommand}" Padding="20,10">
                                <StackPanel Orientation="Horizontal">
                                    <c:IconView Data="{StaticResource Icon.Zap}" Width="15" Height="15" Margin="0,0,8,0" />
                                    <TextBlock Text="Apply gaming profile" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Btn.Glass}" Content="Restore previous plan" Command="{Binding RestorePreviousCommand}" Margin="10,0,0,0"
                                    Visibility="{Binding HasPrevious, Converter={StaticResource BoolToVisibility}}" />
                            <Button Style="{StaticResource Btn.Ghost}" Command="{Binding OpenWindowsPowerSettingsCommand}" Margin="10,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Windows power settings" />
                                    <c:IconView Data="{StaticResource Icon.External}" Width="13" Height="13" Margin="6,0,0,0" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock Text="{Binding PreviousText}" Style="{StaticResource Text.Caption}" Margin="0,10,0,0" Visibility="{Binding HasPrevious, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border CornerRadius="14" Padding="16,12" Margin="0,0,0,16" Background="{StaticResource Brush.WarningSoft}" BorderBrush="#33F1CB7E" BorderThickness="1"
                    Visibility="{Binding Notice, Converter={StaticResource NullToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <c:IconView Data="{StaticResource Icon.Info}" Width="16" Height="16" Foreground="{StaticResource Brush.Warning}" VerticalAlignment="Top" />
                    <TextBlock Text="{Binding Notice}" Margin="10,0,0,0" TextWrapping="Wrap" MaxWidth="900" FontSize="12.5" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <TextBlock Text="Power plans on this PC" Style="{StaticResource Text.H3}" VerticalAlignment="Center" />
                        <Button Style="{StaticResource Btn.Icon}" Command="{Binding RefreshCommand}" HorizontalAlignment="Right" ToolTip="Refresh">
                            <c:IconView Data="{StaticResource Icon.Refresh}" Width="14" Height="14" />
                        </Button>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Schemes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card.Inset}" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="18" Height="18" VerticalAlignment="Center">
                                            <Ellipse Stroke="#40FFFFFF" StrokeThickness="1.5" />
                                            <Ellipse Width="8" Height="8" Fill="{StaticResource Brush.Text}" Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}" />
                                        </Grid>
                                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <Border Style="{StaticResource Badge}" Margin="10,0,0,0">
                                                    <TextBlock Text="{Binding Personality}" Style="{StaticResource Badge.Text}" />
                                                </Border>
                                                <Border Style="{StaticResource Badge}" Margin="6,0,0,0" Background="{StaticResource Brush.InfoSoft}"
                                                        Visibility="{Binding CreatedByFpsLol, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="Created by FPS.LOL" Style="{StaticResource Badge.Text}" Foreground="{StaticResource Brush.Info}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Id}" Style="{StaticResource Text.Caption}" FontFamily="{StaticResource Font.Mono}" FontSize="10.5" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Active" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.Success}" VerticalAlignment="Center"
                                                       Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}" />
                                            <Button Style="{StaticResource Btn.Ghost}" Foreground="{StaticResource Brush.Danger}" Content="Remove" Margin="0,0,6,0"
                                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                    Visibility="{Binding CreatedByFpsLol, Converter={StaticResource BoolToVisibility}}" />
                                            <Button Style="{StaticResource Btn.Glass}" Content="Activate" Padding="14,6"
                                                    Command="{Binding DataContext.ActivateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                    Visibility="{Binding IsActive, Converter={StaticResource InverseBoolToVisibility}}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <Grid>
                    <StackPanel Margin="0,0,200,0">
                        <TextBlock Text="Ultimate Performance" Style="{StaticResource Text.H3}" />
                        <TextBlock Style="{StaticResource Text.Secondary}" FontSize="12.5" Margin="0,4,0,0"
                                   Text="A built-in Windows plan for high-end desktops that eliminates micro power-management latencies. FPS.LOL adds it as a new plan; existing plans are never changed or removed." />
                    </StackPanel>
                    <Button Style="{StaticResource Btn.Glass}" Content="Add plan" Command="{Binding AddUltimateCommand}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
