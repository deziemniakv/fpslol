<UserControl x:Class="FpsLol.Views.Pages.TweaksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:FpsLol.Controls">
    <ScrollViewer Style="{StaticResource PageScroll}">
        <StackPanel MaxWidth="1180">
            <Grid Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="Tweaks" Style="{StaticResource Text.H1}" />
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Secondary}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBox Style="{StaticResource SearchBox}" Tag="Search tweaks" Width="240" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Style="{StaticResource Btn.Glass}" Command="{Binding RefreshCommand}" Margin="8,0,0,0" ToolTip="Re-read all settings">
                        <Grid>
                            <c:IconView Data="{StaticResource Icon.Refresh}" Width="14" Height="14" Visibility="{Binding IsBusy, Converter={StaticResource InverseBoolToVisibility}}" />
                            <c:Spinner Width="14" Height="14" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>

            <ListBox Style="{StaticResource ChipList}" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" Margin="0,0,0,12" />

            <Border Style="{StaticResource Card.Inset}" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal">
                    <c:IconView Data="{StaticResource Icon.Info}" Width="15" Height="15" Foreground="{StaticResource Brush.Info}" />
                    <TextBlock Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.TextSecondary}" Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"
                               Text="SAFE: no side effects expected · MODERATE: changes a feature you might use · ADVANCED: for experienced users. Restore returns the exact previous value." />
                </StackPanel>
            </Border>

            <StackPanel Visibility="{Binding IsLoaded, Converter={StaticResource InverseBoolToVisibility}}">
                <c:SkeletonBlock Height="120" CornerRadius="18" Margin="0,0,0,10" />
                <c:SkeletonBlock Height="120" CornerRadius="18" Margin="0,0,0,10" />
                <c:SkeletonBlock Height="120" CornerRadius="18" />
            </StackPanel>

            <ItemsControl ItemsSource="{Binding ItemsView}" ItemTemplate="{StaticResource TweakCardTemplate}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
