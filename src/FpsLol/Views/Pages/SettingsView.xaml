<UserControl x:Class="FpsLol.Views.Pages.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:FpsLol.Controls">
    <UserControl.Resources>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,18" />
        </Style>
        <Style x:Key="RowText" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,90,0" />
        </Style>
        <Style x:Key="Section" TargetType="TextBlock" BasedOn="{StaticResource Text.Overline}">
            <Setter Property="Margin" Value="0,0,0,18" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer Style="{StaticResource PageScroll}">
        <StackPanel MaxWidth="980">
            <StackPanel Margin="0,0,0,22">
                <TextBlock Text="Settings" Style="{StaticResource Text.H1}" />
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Secondary}" Margin="0,4,0,0" />
            </StackPanel>

            <!-- General -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="General" Style="{StaticResource Section}" />
                    <Grid Style="{StaticResource Row}">
                        <StackPanel Style="{StaticResource RowText}">
                            <TextBlock Text="Start with Windows" FontWeight="SemiBold" />
                            <TextBlock Text="Starts FPS.LOL minimized when you sign in." Style="{StaticResource Text.Caption}" Margin="0,3,0,0" />
                        </StackPanel>
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding StartWithWindows}" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <StackPanel Style="{StaticResource RowText}">
                            <TextBlock Text="Minimize to tray" FontWeight="SemiBold" />
                            <TextBlock Text="Closing the window keeps FPS.LOL running in the notification area." Style="{StaticResource Text.Caption}" Margin="0,3,0,0" />
                        </StackPanel>
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding MinimizeToTray}" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid Margin="0">
                        <StackPanel Style="{StaticResource RowText}">
                            <TextBlock Text="Notifications" FontWeight="SemiBold" />
                            <TextBlock Text="Show Windows notifications for results while FPS.LOL is in the tray." Style="{StaticResource Text.Caption}" Margin="0,3,0,0" />
                        </StackPanel>
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Notifications}" HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Appearance -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Appearance" Style="{StaticResource Section}" />
                    <Grid Style="{StaticResource Row}">
                        <StackPanel Style="{StaticResource RowText}" Margin="0,0,320,0">
                            <TextBlock Text="Liquid Glass intensity" FontWeight="SemiBold" />
                            <TextBlock Text="Translucency of panels and the window surface." Style="{StaticResource Text.Caption}" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Slider Width="240" Minimum="0" Maximum="100" Value="{Binding GlassIntensity}" SmallChange="5" LargeChange="10" />
                            <TextBlock Width="44" TextAlignment="Right" Text="{Binding GlassIntensity, StringFormat={}{0:0}%}" VerticalAlignment="Center" Foreground="{StaticResource Brush.TextSecondary}" />
                        </StackPanel>
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <StackPanel Style="{StaticResource RowText}">
                            <TextBlock Text="Blur" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding BlurNote}" Style="{StaticResource Text.Caption}" Margin="0,3,0,0" />
                        </StackPanel>
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding BlurEnabled}" IsEnabled="{Binding BlurSupported}" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <StackPanel Style="{StaticResource RowText}" Margin="0,0,320,0">
                            <TextBlock Text="Animation intensity" FontWeight="SemiBold" />
                            <TextBlock Text="Lower values make transitions shorter and subtler." Style="{StaticResource Text.Caption}" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Slider Width="240" Minimum="0" Maximum="100" Value="{Binding AnimationIntensity}" SmallChange="5" LargeChange="10"
                                    IsEnabled="{Binding ReduceAnimations, Converter={StaticResource InverseBool}}" />
                            <TextBlock Width="44" TextAlignment="Right" Text="{Binding AnimationIntensity, StringFormat={}{0:0}%}" VerticalAlignment="Center" Foreground="{StaticResource Brush.TextSecondary}" />
                        </StackPanel>
                    </Grid>
                    <Grid>
                        <StackPanel Style="{StaticResource RowText}">
                            <TextBlock Text="Reduce animations" FontWeight="SemiBold" />
                            <TextBlock Text="Turns off page transitions, ambient light motion and loading shimmer." Style="{StaticResource Text.Caption}" Margin="0,3,0,0" />
                        </StackPanel>
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ReduceAnimations}" HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Optimization -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Optimization" Style="{StaticResource Section}" />
                    <Grid Style="{StaticResource Row}">
                        <StackPanel Style="{StaticResource RowText}">
                            <TextBlock Text="Ask before applying tweaks" FontWeight="SemiBold" />
                            <TextBlock Text="Show a confirmation with the exact change before anything is applied." Style="{StaticResource Text.Caption}" Margin="0,3,0,0" />
                        </StackPanel>
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AskBeforeApplying}" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid>
                        <StackPanel Style="{StaticResource RowText}">
                            <TextBlock Text="Create restore point before optimization" FontWeight="SemiBold" />
                            <TextBlock Text="Creates a Windows System Restore point before One-Click Optimize (requires System Protection and administrator permission). FPS.LOL's own backup is always created." Style="{StaticResource Text.Caption}" Margin="0,3,0,0" />
                        </StackPanel>
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding CreateRestorePoint}" HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Advanced -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Advanced" Style="{StaticResource Section}" />
                    <Grid Style="{StaticResource Row}">
                        <StackPanel Style="{StaticResource RowText}">
                            <TextBlock Text="Logging" FontWeight="SemiBold" />
                            <TextBlock Text="Write a readable log file of scans, changes, restores and errors." Style="{StaticResource Text.Caption}" Margin="0,3,0,0" />
                        </StackPanel>
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding LoggingEnabled}" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <StackPanel Style="{StaticResource RowText}">
                            <TextBlock Text="Debug mode" FontWeight="SemiBold" />
                            <TextBlock Text="Adds detailed diagnostic entries and full exception details to the log." Style="{StaticResource Text.Caption}" Margin="0,3,0,0" />
                        </StackPanel>
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding DebugMode}" HorizontalAlignment="Right" />
                    </Grid>
                    <WrapPanel>
                        <Button Style="{StaticResource Btn.Glass}" Command="{Binding OpenLogsFolderCommand}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <c:IconView Data="{StaticResource Icon.FileText}" Width="14" Height="14" Margin="0,0,8,0" />
                                <TextBlock Text="Open logs folder" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Btn.Glass}" Command="{Binding OpenDataFolderCommand}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <c:IconView Data="{StaticResource Icon.Folder}" Width="14" Height="14" Margin="0,0,8,0" />
                                <TextBlock Text="Open data folder" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Btn.Ghost}" Content="Show welcome screen again" Command="{Binding ResetFirstRunCommand}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Logs -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="Activity log" Style="{StaticResource Text.Overline}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource Btn.Ghost}" Command="{Binding CopyLogsCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <c:IconView Data="{StaticResource Icon.Copy}" Width="13" Height="13" Margin="0,0,6,0" />
                                    <TextBlock Text="Copy" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Btn.Ghost}" Content="Clear view" Command="{Binding ClearLogViewCommand}" />
                        </StackPanel>
                    </Grid>
                    <Border Style="{StaticResource Card.Inset}" Padding="12,10" Background="#40000000">
                        <ListBox ItemsSource="{Binding Logs}" Height="260" Background="Transparent" BorderThickness="0"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" Loaded="OnLogsLoaded">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock FontFamily="{StaticResource Font.Mono}" FontSize="11.5" TextWrapping="Wrap" Margin="0,1">
                                        <Run Text="{Binding Timestamp, StringFormat='[{0:HH:mm:ss}]', Mode=OneWay}" Foreground="{StaticResource Brush.TextTertiary}" />
                                        <Run Text="{Binding LevelText, Mode=OneWay}">
                                            <Run.Style>
                                                <Style TargetType="Run">
                                                    <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding LevelText}" Value="SUCCESS"><Setter Property="Foreground" Value="{StaticResource Brush.Success}" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding LevelText}" Value="WARN"><Setter Property="Foreground" Value="{StaticResource Brush.Warning}" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding LevelText}" Value="ERROR"><Setter Property="Foreground" Value="{StaticResource Brush.Danger}" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding LevelText}" Value="DEBUG"><Setter Property="Foreground" Value="{StaticResource Brush.Info}" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Run.Style>
                                        </Run>
                                        <Run Text="{Binding Message, Mode=OneWay}" Foreground="{StaticResource Brush.Text}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </StackPanel>
            </Border>

            <!-- About -->
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Top" Margin="0,0,28,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="FPS" FontFamily="{StaticResource Font.Display}" FontSize="26" FontWeight="Bold" />
                            <TextBlock Text=".LOL" FontFamily="{StaticResource Font.Display}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource Brush.TextTertiary}" />
                        </StackPanel>
                        <TextBlock Text="Optimize. Play. Perform." Style="{StaticResource Text.Caption}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Style="{StaticResource Text.Body}"><Run Text="Version " /><Run Text="{Binding Version, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
                        <TextBlock Text="{Binding RuntimeText}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding WindowsText}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0" />
                        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,2,0,0"><Run Text="Data: " /><Run Text="{Binding DataFolder, Mode=OneWay}" /></TextBlock>
                        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,12,0,0" TextWrapping="Wrap"
                                   Text="Credits: built with .NET 8 and WPF · CommunityToolkit.Mvvm · Microsoft.Extensions.DependencyInjection · Microsoft TraceEvent (frame-rate capture) · icon geometry inspired by Lucide (ISC license)." />
                        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Text="FPS.LOL does not overclock hardware, install drivers, disable Windows security or updates, or delete registry keys." />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
