<UserControl x:Class="FpsLol.Views.Pages.StartupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:FpsLol.Controls">
    <ScrollViewer Style="{StaticResource PageScroll}">
        <StackPanel MaxWidth="1180">
            <Grid Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="Startup" Style="{StaticResource Text.H1}" />
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Secondary}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource Btn.Ghost}" Command="{Binding OpenTaskManagerCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Task Manager" />
                            <c:IconView Data="{StaticResource Icon.External}" Width="13" Height="13" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Btn.Glass}" Command="{Binding RefreshCommand}" Margin="8,0,0,0" ToolTip="Refresh">
                        <c:IconView Data="{StaticResource Icon.Refresh}" Width="14" Height="14" />
                    </Button>
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource Card.Inset}" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal">
                    <c:IconView Data="{StaticResource Icon.Info}" Width="15" Height="15" Foreground="{StaticResource Brush.Info}" />
                    <TextBlock Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.TextSecondary}" Margin="10,0,0,0" TextWrapping="Wrap" MaxWidth="1000"
                               Text="Disabling works exactly like Task Manager: the entry is kept and can be re-enabled at any time. Startup impact is not shown because Windows does not expose a reliable per-app measurement. Store apps and scheduled tasks are managed in Task Manager." />
                </StackPanel>
            </Border>

            <StackPanel Visibility="{Binding IsLoaded, Converter={StaticResource InverseBoolToVisibility}}">
                <c:SkeletonBlock Height="70" CornerRadius="18" Margin="0,0,0,8" />
                <c:SkeletonBlock Height="70" CornerRadius="18" Margin="0,0,0,8" />
                <c:SkeletonBlock Height="70" CornerRadius="18" />
            </StackPanel>

            <Border Style="{StaticResource Card}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                <StackPanel HorizontalAlignment="Center" Margin="0,24">
                    <c:IconView Data="{StaticResource Icon.Rocket}" Width="32" Height="32" Foreground="{StaticResource Brush.TextTertiary}" />
                    <TextBlock Text="No startup apps found" Style="{StaticResource Text.H3}" HorizontalAlignment="Center" Margin="0,12,0,0" />
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="260" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconTile}">
                                    <Grid>
                                        <Image Source="{Binding Icon}" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality" />
                                        <c:IconView Data="{StaticResource Icon.Rocket}" Width="16" Height="16" Foreground="{StaticResource Brush.TextTertiary}"
                                                    Visibility="{Binding Icon, Converter={StaticResource InverseNullToVisibility}}" />
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <Border Style="{StaticResource Badge}" Margin="10,0,0,0" Visibility="{Binding ShowAdmin, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="ADMIN" Style="{StaticResource Badge.Text}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Path}" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,3,0,0" ToolTip="{Binding Command}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Publisher}" TextTrimming="CharacterEllipsis" FontSize="12.5" ToolTip="Publisher" />
                                    <TextBlock Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,3,0,0"
                                               ToolTip="Startup impact is N/A: Windows does not expose a reliable per-app measurement outside Task Manager.">
                                        <Run Text="{Binding Location, Mode=OneWay}" /><Run Text=" · Impact: " /><Run Text="{Binding Impact, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                    <c:Spinner Width="14" Height="14" Margin="0,0,10,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Width="60" TextAlignment="Right" Margin="0,0,12,0" VerticalAlignment="Center" FontSize="12">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Disabled" />
                                                <Setter Property="Foreground" Value="{StaticResource Brush.TextTertiary}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                        <Setter Property="Text" Value="Enabled" />
                                                        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                              Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
