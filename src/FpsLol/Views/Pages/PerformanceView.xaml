<UserControl x:Class="FpsLol.Views.Pages.PerformanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:FpsLol.Controls">
    <ScrollViewer Style="{StaticResource PageScroll}">
        <StackPanel MaxWidth="1280">
            <StackPanel Margin="0,0,0,22">
                <TextBlock Text="Performance" Style="{StaticResource Text.H1}" />
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Secondary}" Margin="0,4,0,0" />
            </StackPanel>

            <!-- Frame rate -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Frame rate" Style="{StaticResource Text.Overline}" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <StackPanel Margin="0,0,40,0">
                                <TextBlock Text="{Binding FpsText}" Style="{StaticResource Text.Display}" FontSize="44" />
                                <TextBlock Text="FPS" Style="{StaticResource Text.Caption}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,40,0" VerticalAlignment="Bottom">
                                <TextBlock Text="{Binding FrameTimeText}" Style="{StaticResource Text.Metric}" FontSize="22" />
                                <TextBlock Text="Frame time" Style="{StaticResource Text.Caption}" />
                            </StackPanel>
                            <StackPanel VerticalAlignment="Bottom">
                                <TextBlock Text="{Binding LowText}" Style="{StaticResource Text.Metric}" FontSize="22" />
                                <TextBlock Text="1% low FPS" Style="{StaticResource Text.Caption}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Width="340">
                        <TextBlock Text="Application" Style="{StaticResource Text.Caption}" Margin="0,0,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding Candidates}" SelectedItem="{Binding SelectedCandidate}" DisplayMemberPath="Display"
                                      IsEnabled="{Binding IsCapturing, Converter={StaticResource InverseBool}}" />
                            <Button Grid.Column="1" Style="{StaticResource Btn.Icon}" Command="{Binding RefreshCandidatesCommand}" Margin="6,0,0,0" ToolTip="Refresh list">
                                <c:IconView Data="{StaticResource Icon.Refresh}" Width="15" Height="15" />
                            </Button>
                        </Grid>
                        <Button Command="{Binding ToggleCaptureCommand}" Margin="0,10,0,0" HorizontalAlignment="Stretch">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Btn.Primary}">
                                    <Setter Property="Content" Value="Start capture" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCapturing}" Value="True">
                                            <Setter Property="Content" Value="Stop capture" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,18,0,0">
                        <Grid Height="90">
                            <c:Sparkline Values="{Binding FpsSeries}" AutoScale="True" ShowGrid="True" Stroke="{StaticResource Brush.SeriesGpu}" />
                            <TextBlock Text="FPS history (60 s)" Style="{StaticResource Text.Caption}" VerticalAlignment="Top" HorizontalAlignment="Right" />
                        </Grid>
                        <Border Style="{StaticResource Card.Inset}" Margin="0,14,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <c:IconView Data="{StaticResource Icon.Info}" Width="16" Height="16" Foreground="{StaticResource Brush.Info}" VerticalAlignment="Top" Margin="0,1,10,0" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding CaptureStatus}" Style="{StaticResource Text.Secondary}" FontSize="12.5" />
                                    <TextBlock Text="{Binding FpsUnsupportedReason}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0"
                                               Visibility="{Binding FpsUnsupportedReason, Converter={StaticResource NullToVisibility}}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Metrics -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="CPU" Style="{StaticResource Text.Overline}" />
                            <TextBlock Text="{Binding CpuText}" Style="{StaticResource Text.Metric}" FontSize="22" HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock Text="{Binding CpuName}" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                        <c:Sparkline Values="{Binding CpuHistory}" ShowGrid="True" Stroke="{StaticResource Brush.SeriesCpu}" Height="120" Margin="0,14,0,14" />
                        <UniformGrid Columns="2">
                            <StackPanel>
                                <TextBlock Text="Clock" Style="{StaticResource Text.Caption}" />
                                <TextBlock Text="{Binding CpuClockText}" FontWeight="Medium" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Temperature" Style="{StaticResource Text.Caption}" />
                                <TextBlock Text="{Binding CpuTempText}" FontWeight="Medium" Margin="0,3,0,0" ToolTip="{Binding CpuTempNote}" />
                            </StackPanel>
                        </UniformGrid>
                        <TextBlock Text="{Binding CpuTempNote}" Style="{StaticResource Text.Caption}" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="GPU" Style="{StaticResource Text.Overline}" />
                            <TextBlock Text="{Binding GpuText}" Style="{StaticResource Text.Metric}" FontSize="22" HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock Text="{Binding GpuName}" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                        <c:Sparkline Values="{Binding GpuHistory}" ShowGrid="True" Stroke="{StaticResource Brush.SeriesGpu}" Height="120" Margin="0,14,0,14" />
                        <UniformGrid Columns="2">
                            <StackPanel>
                                <TextBlock Text="Temperature" Style="{StaticResource Text.Caption}" />
                                <TextBlock Text="{Binding GpuTempText}" FontWeight="Medium" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="VRAM" Style="{StaticResource Text.Caption}" />
                                <TextBlock Text="{Binding VramText}" FontWeight="Medium" Margin="0,3,0,0" />
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Memory" Style="{StaticResource Text.Overline}" />
                            <TextBlock Text="{Binding RamText}" Style="{StaticResource Text.Metric}" FontSize="22" HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock Text="{Binding RamDetail}" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                        <c:Sparkline Values="{Binding RamHistory}" ShowGrid="True" Stroke="{StaticResource Brush.SeriesRam}" Height="120" Margin="0,14,0,14" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
