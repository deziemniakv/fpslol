<UserControl x:Class="FpsLol.Views.Pages.NetworkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:FpsLol.Controls">
    <UserControl.Resources>
        <Style x:Key="L" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}" />
        <Style x:Key="V" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Margin" Value="0,3,0,14" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer Style="{StaticResource PageScroll}">
        <StackPanel MaxWidth="1180">
            <Grid Margin="0,0,0,22">
                <StackPanel>
                    <TextBlock Text="Network" Style="{StaticResource Text.H1}" />
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Secondary}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <ComboBox Width="340" ItemsSource="{Binding Adapters}" SelectedItem="{Binding SelectedAdapter}" DisplayMemberPath="Display" />
                    <Button Style="{StaticResource Btn.Glass}" Command="{Binding RefreshCommand}" Margin="8,0,0,0" ToolTip="Refresh adapters">
                        <c:IconView Data="{StaticResource Icon.Refresh}" Width="14" Height="14" />
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Adapter -->
                <Border Style="{StaticResource Card}" DataContext="{Binding SelectedAdapter}">
                    <StackPanel>
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource IconTile}">
                                <c:IconView Data="{StaticResource Icon.Network}" Width="17" Height="17" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name, FallbackValue=No adapter}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Type" Style="{StaticResource L}" />
                                <TextBlock Text="{Binding Type}" Style="{StaticResource V}" />
                                <TextBlock Text="Link speed" Style="{StaticResource L}" />
                                <TextBlock Text="{Binding SpeedText}" Style="{StaticResource V}" />
                                <TextBlock Text="IPv4" Style="{StaticResource L}" />
                                <TextBlock Text="{Binding IPv4Text}" Style="{StaticResource V}" />
                                <TextBlock Text="Gateway" Style="{StaticResource L}" />
                                <TextBlock Text="{Binding GatewayText}" Style="{StaticResource V}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Status" Style="{StaticResource L}" />
                                <TextBlock Text="{Binding Status}" Style="{StaticResource V}" />
                                <TextBlock Text="MAC address" Style="{StaticResource L}" />
                                <TextBlock Text="{Binding Mac}" Style="{StaticResource V}" />
                                <TextBlock Text="IPv6" Style="{StaticResource L}" />
                                <TextBlock Text="{Binding IPv6Text}" Style="{StaticResource V}" FontSize="12" />
                                <TextBlock Style="{StaticResource L}"><Run Text="DNS · " /><Run Text="{Binding DnsModeText, Mode=OneWay}" /></TextBlock>
                                <TextBlock Text="{Binding DnsText}" Style="{StaticResource V}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Latency -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Latency &amp; packet loss" Style="{StaticResource Text.H3}" />
                                <TextBlock Text="20 ICMP pings per target" Style="{StaticResource Text.Caption}" Margin="0,2,0,0" />
                            </StackPanel>
                            <Button Style="{StaticResource Btn.Primary}" Command="{Binding RunLatencyTestCommand}" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="14,7">
                                <StackPanel Orientation="Horizontal">
                                    <c:Spinner Width="13" Height="13" Margin="0,0,8,0" Foreground="{StaticResource Brush.TextInverse}" Visibility="{Binding IsTesting, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Text="Run test" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <TextBlock Text="Measures round-trip time to your router and to public DNS resolvers. Game server ping depends on the server location." Style="{StaticResource Text.Caption}"
                                   Visibility="{Binding HasLatency, Converter={StaticResource InverseBoolToVisibility}}" />
                        <ItemsControl ItemsSource="{Binding Latency}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card.Inset}" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="7" Height="7" Fill="{Binding Tone, Converter={StaticResource ToneBrush}}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Target}" Style="{StaticResource Text.Caption}" Margin="8,1,0,0" />
                                                </StackPanel>
                                                <TextBlock Style="{StaticResource Text.Caption}" Margin="15,4,0,0">
                                                    <Run Text="Range " /><Run Text="{Binding RangeText, Mode=OneWay}" /><Run Text=" · Jitter " /><Run Text="{Binding JitterText, Mode=OneWay}" /><Run Text=" · Loss " /><Run Text="{Binding LossText, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding AvgText}" Style="{StaticResource Text.Metric}" FontSize="20" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- DNS -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="DNS configuration" Style="{StaticResource Text.H3}" />
                            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,3,0,0" TextWrapping="Wrap" MaxWidth="720" HorizontalAlignment="Left"
                                       Text="DNS affects how quickly websites, launchers and matchmaking services resolve names. It does not change your ping to a game server. The previous configuration is saved and can be restored." />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <Button Style="{StaticResource Btn.Ghost}" Content="Flush DNS cache" Command="{Binding FlushDnsCommand}" />
                            <Button Style="{StaticResource Btn.Primary}" Content="Apply DNS" Command="{Binding ApplyDnsCommand}" Margin="8,0,0,0" />
                        </StackPanel>
                    </Grid>
                    <ListBox Style="{StaticResource CardList}" ItemsSource="{Binding DnsPresets}" SelectedItem="{Binding SelectedPreset}" Margin="0,12,0,0">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource CardItem}">
                                <Setter Property="Margin" Value="0,0,8,0" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding ServersText}" Style="{StaticResource Text.Caption}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,6,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="Changing DNS requires administrator permission — Windows will ask when you apply." Style="{StaticResource Text.Caption}" Margin="0,12,0,0"
                               Visibility="{Binding ShowAdminHint, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>

            <TextBlock Text="Network settings" Style="{StaticResource Text.Overline}" Margin="4,6,0,10" />
            <ItemsControl ItemsSource="{Binding Tweaks}" ItemTemplate="{StaticResource TweakCardTemplate}" />
            <Border Style="{StaticResource Card.Inset}" Margin="0,4,0,0">
                <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                           Text="FPS.LOL intentionally does not apply registry “TCP gaming tweaks” such as disabling Nagle's algorithm or network throttling: modern games use UDP and these values have no measurable benefit on current Windows versions." />
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
