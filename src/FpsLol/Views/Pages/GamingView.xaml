<UserControl x:Class="FpsLol.Views.Pages.GamingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:FpsLol.Controls">
    <ScrollViewer Style="{StaticResource PageScroll}">
        <StackPanel MaxWidth="1280">
            <Grid Margin="0,0,0,22">
                <StackPanel>
                    <TextBlock Text="Gaming" Style="{StaticResource Text.H1}" />
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Secondary}" Margin="0,4,0,0" />
                </StackPanel>
                <Button Style="{StaticResource Btn.Glass}" Content="Windows gaming tweaks" Command="{Binding OpenTweaksCommand}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>

            <!-- Status -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Gaming status" Style="{StaticResource Text.Overline}" Margin="0,0,0,16" />
                    <ItemsControl ItemsSource="{Binding Status}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="5" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card.Inset}" Margin="0,0,10,0" Padding="14,14">
                                    <StackPanel>
                                        <c:IconView Data="{Binding Icon, Converter={StaticResource ResourceKey}}" Width="17" Height="17" HorizontalAlignment="Left" Foreground="{StaticResource Brush.TextSecondary}" />
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Caption}" Margin="0,10,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Label}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <Ellipse Width="6" Height="6" Fill="{Binding Tone, Converter={StaticResource ToneBrush}}" VerticalAlignment="Center" Margin="0,0,7,0" />
                                            <TextBlock Text="{Binding Value}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Value}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Profiles -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <Border Style="{StaticResource Card}" Padding="18">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <TextBlock Text="Game profiles" Style="{StaticResource Text.H3}" VerticalAlignment="Center" />
                                <Button Style="{StaticResource Btn.Glass}" Command="{Binding AddManualCommand}" HorizontalAlignment="Right" Padding="12,6">
                                    <StackPanel Orientation="Horizontal">
                                        <c:IconView Data="{StaticResource Icon.Plus}" Width="13" Height="13" Margin="0,0,6,0" />
                                        <TextBlock Text="Add game" FontSize="12.5" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <TextBlock Text="No profiles yet. Add a detected game below or pick an executable manually." Style="{StaticResource Text.Caption}"
                                       Visibility="{Binding HasProfiles, Converter={StaticResource InverseBoolToVisibility}}" />
                            <ListBox Style="{StaticResource CardList}" ItemsSource="{Binding Profiles}" SelectedItem="{Binding Selected}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="36" Height="36" CornerRadius="10" Background="#14FFFFFF">
                                                <TextBlock Text="{Binding Initials}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                                                    <Run Text="{Binding Source, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding ExecutableName, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="18" Margin="0,16,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="Detected games" Style="{StaticResource Text.H3}" VerticalAlignment="Center" />
                                <Button Style="{StaticResource Btn.Icon}" Command="{Binding DetectGamesCommand}" HorizontalAlignment="Right" ToolTip="Scan Steam, Epic Games and Riot libraries">
                                    <Grid>
                                        <c:IconView Data="{StaticResource Icon.Refresh}" Width="14" Height="14" Visibility="{Binding IsDetecting, Converter={StaticResource InverseBoolToVisibility}}" />
                                        <c:Spinner Width="14" Height="14" Visibility="{Binding IsDetecting, Converter={StaticResource BoolToVisibility}}" />
                                    </Grid>
                                </Button>
                            </Grid>
                            <TextBlock Style="{StaticResource Text.Caption}" Visibility="{Binding HasSuggestions, Converter={StaticResource InverseBoolToVisibility}}"
                                       Text="No new games found in Steam, Epic Games or Riot libraries. Use “Add game” for other launchers." />
                            <ItemsControl ItemsSource="{Binding Suggestions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Source}" Style="{StaticResource Text.Caption}" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Style="{StaticResource Btn.Glass}" Content="Add" Padding="12,5" FontSize="12"
                                                    Command="{Binding DataContext.AddDetectedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Editor -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="26,24" VerticalAlignment="Top">
                    <Grid>
                        <StackPanel Visibility="{Binding Selected, Converter={StaticResource InverseNullToVisibility}}" HorizontalAlignment="Center" Margin="0,40">
                            <c:IconView Data="{StaticResource Icon.Gamepad}" Width="34" Height="34" Foreground="{StaticResource Brush.TextTertiary}" />
                            <TextBlock Text="Select or add a game" Style="{StaticResource Text.H3}" HorizontalAlignment="Center" Margin="0,12,0,0" />
                            <TextBlock Text="Profiles store per-game CPU priority, GPU preference and fullscreen settings." Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel DataContext="{Binding Selected}" Visibility="{Binding Converter={StaticResource NullToVisibility}}">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Text.H1}" FontSize="22" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding ExecutablePath}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding ExecutablePath}" />
                                </StackPanel>
                                <Border Style="{StaticResource Badge}" HorizontalAlignment="Right" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding StateText}" Style="{StaticResource Badge.Text}" />
                                </Border>
                            </Grid>
                            <TextBlock Text="The game executable was not found at this path." Foreground="{StaticResource Brush.Warning}" FontSize="12" Margin="0,8,0,0"
                                       Visibility="{Binding ExeExists, Converter={StaticResource InverseBoolToVisibility}}" />

                            <Rectangle Style="{StaticResource Divider}" Margin="0,20" />

                            <!-- Priority -->
                            <Grid Margin="0,0,0,20">
                                <StackPanel Margin="0,0,300,0">
                                    <TextBlock Text="CPU priority" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource Text.Caption}" Margin="0,3,0,0"
                                               Text="Applied by Windows each time the game starts. Above normal is usually enough; High can starve background apps like voice chat. Requires administrator." />
                                </StackPanel>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="10" Background="#0CFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" Padding="3">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource Segment}" Content="Default" GroupName="{Binding ExecutablePath}"
                                                     IsChecked="{Binding Priority, Converter={StaticResource EqualsToBool}, ConverterParameter=Default}" />
                                        <RadioButton Style="{StaticResource Segment}" Content="Above normal" GroupName="{Binding ExecutablePath}"
                                                     IsChecked="{Binding Priority, Converter={StaticResource EqualsToBool}, ConverterParameter=AboveNormal}" />
                                        <RadioButton Style="{StaticResource Segment}" Content="High" GroupName="{Binding ExecutablePath}"
                                                     IsChecked="{Binding Priority, Converter={StaticResource EqualsToBool}, ConverterParameter=High}" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid Margin="0,0,0,20">
                                <StackPanel Margin="0,0,80,0">
                                    <TextBlock Text="Use high-performance GPU" FontWeight="SemiBold" />
                                    <TextBlock Text="Windows Graphics setting. On laptops with two GPUs this forces the dedicated GPU." Style="{StaticResource Text.Caption}" Margin="0,3,0,0" />
                                </StackPanel>
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding HighPerformanceGpu}" HorizontalAlignment="Right" />
                            </Grid>

                            <Grid Margin="0,0,0,20">
                                <StackPanel Margin="0,0,80,0">
                                    <TextBlock Text="Disable fullscreen optimizations" FontWeight="SemiBold" />
                                    <TextBlock Text="Compatibility option. Only helps some older DirectX 9/11 games with alt-tab or stutter issues; leave off otherwise." Style="{StaticResource Text.Caption}" Margin="0,3,0,0" />
                                </StackPanel>
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding DisableFullscreenOptimizations}" HorizontalAlignment="Right" />
                            </Grid>

                            <TextBlock Text="Notes" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <TextBox Text="{Binding Notes, UpdateSourceTrigger=LostFocus}" Tag="In-game settings, sensitivity, anything worth remembering…" AcceptsReturn="True"
                                     TextWrapping="Wrap" MinHeight="72" VerticalContentAlignment="Top" />

                            <Border Style="{StaticResource Card.Inset}" Margin="0,16,0,0">
                                <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                           Text="Settings take effect the next time the game starts. Some anti-cheat protected games may ignore the priority setting. All changes are recorded in the Restore Center." />
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                                <Button Style="{StaticResource Btn.Primary}" Content="Apply profile" Padding="20,10"
                                        Command="{Binding DataContext.ApplyProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                <Button Style="{StaticResource Btn.Glass}" Content="Revert" Margin="10,0,0,0"
                                        Command="{Binding DataContext.RevertProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        Visibility="{Binding HasAppliedSettings, Converter={StaticResource BoolToVisibility}}" />
                                <Button Style="{StaticResource Btn.Ghost}" Margin="10,0,0,0"
                                        Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <StackPanel Orientation="Horizontal">
                                        <c:IconView Data="{StaticResource Icon.Folder}" Width="14" Height="14" Margin="0,0,6,0" />
                                        <TextBlock Text="Open folder" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource Btn.Ghost}" Margin="4,0,0,0" Foreground="{StaticResource Brush.Danger}"
                                        Command="{Binding DataContext.RemoveProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <StackPanel Orientation="Horizontal">
                                        <c:IconView Data="{StaticResource Icon.Trash}" Width="14" Height="14" Margin="0,0,6,0" />
                                        <TextBlock Text="Remove" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
