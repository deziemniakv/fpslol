<UserControl x:Class="FpsLol.Views.Pages.CleanupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:FpsLol.Controls">
    <ScrollViewer Style="{StaticResource PageScroll}">
        <StackPanel MaxWidth="1100">
            <StackPanel Margin="0,0,0,22">
                <TextBlock Text="Cleanup" Style="{StaticResource Text.H1}" />
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Secondary}" Margin="0,4,0,0" />
            </StackPanel>

            <Border Style="{StaticResource Card}" Padding="28,24" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconTile}" Width="52" Height="52" CornerRadius="16">
                        <c:IconView Data="{StaticResource Icon.HardDrive}" Width="24" Height="24" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="20,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TotalText}" Style="{StaticResource Text.H1}" FontSize="24" />
                        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,0" Text="Scan first. Nothing is deleted until you review the result and click Clean." />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource Btn.Glass}" Command="{Binding ScanCommand}" Padding="18,10" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <c:Spinner Width="14" Height="14" Margin="0,0,8,0" Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="Scan" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Btn.Primary}" Command="{Binding CleanCommand}" Padding="20,10">
                            <StackPanel Orientation="Horizontal">
                                <c:Spinner Width="14" Height="14" Margin="0,0,8,0" Foreground="{StaticResource Brush.TextInverse}" Visibility="{Binding IsCleaning, Converter={StaticResource BoolToVisibility}}" />
                                <c:IconView Data="{StaticResource Icon.Trash}" Width="14" Height="14" Margin="0,0,8,0" Visibility="{Binding IsCleaning, Converter={StaticResource InverseBoolToVisibility}}" />
                                <TextBlock Text="Clean" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Border CornerRadius="14" Padding="18,14" Margin="0,0,0,16" Background="{StaticResource Brush.SuccessSoft}" BorderBrush="#338BE3BD" BorderThickness="1"
                    Visibility="{Binding HasResults, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <c:IconView Data="{StaticResource Icon.CircleCheck}" Width="17" Height="17" Foreground="{StaticResource Brush.Success}" />
                        <TextBlock Text="{Binding ResultText}" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Results}" Margin="27,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,2">
                                    <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" — " /><Run Text="{Binding Message, Mode=OneWay}" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="170" />
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Top" Margin="0,1,0,0" />
                                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Text.H3}" />
                                        <Border Style="{StaticResource Badge}" Margin="10,0,0,0" Visibility="{Binding ShowAdmin, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="ADMIN" Style="{StaticResource Badge.Text}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Secondary}" FontSize="12.5" Margin="0,4,0,0" />
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibility}}">
                                        <c:IconView Data="{StaticResource Icon.Alert}" Width="13" Height="13" Foreground="{StaticResource Brush.Warning}" VerticalAlignment="Top" Margin="0,1,0,0" />
                                        <TextBlock Text="{Binding Warning}" FontSize="12" Foreground="{StaticResource Brush.Warning}" Margin="6,0,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SizeText}" Style="{StaticResource Text.H2}" HorizontalAlignment="Right" />
                                    <TextBlock Text="{Binding DetailText}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" TextAlignment="Right" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource Card.Inset}" Margin="0,8,0,0">
                <Grid>
                    <TextBlock Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,380,0" TextWrapping="Wrap"
                               Text="FPS.LOL never empties the Recycle Bin, touches Windows Update files or deletes personal files. Use the Windows tools for deeper cleanup." />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource Btn.Ghost}" Command="{Binding OpenDiskCleanupCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Disk Cleanup" />
                                <c:IconView Data="{StaticResource Icon.External}" Width="12" Height="12" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Btn.Ghost}" Command="{Binding OpenStorageSettingsCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Storage Sense" />
                                <c:IconView Data="{StaticResource Icon.External}" Width="12" Height="12" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
