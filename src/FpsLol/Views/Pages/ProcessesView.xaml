<UserControl x:Class="FpsLol.Views.Pages.ProcessesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:FpsLol.Controls">
    <UserControl.Resources>
        <Style x:Key="HeaderButton" TargetType="Button" BasedOn="{StaticResource Btn.Link}">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="FontSize" Value="11.5" />
        </Style>
    </UserControl.Resources>
    <Grid Margin="32,4,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="Processes" Style="{StaticResource Text.H1}" />
                <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Secondary}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBox Style="{StaticResource SearchBox}" Tag="Search name or PID" Width="240" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AutoRefresh}" Margin="16,0,8,0" ToolTip="Refresh every 2 seconds" />
                <TextBlock Text="Live" Foreground="{StaticResource Brush.TextSecondary}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <Button Style="{StaticResource Btn.Glass}" Command="{Binding RefreshCommand}" ToolTip="Refresh now">
                    <c:IconView Data="{StaticResource Icon.Refresh}" Width="14" Height="14" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Column header -->
        <Border Grid.Row="1" Padding="14,0" Margin="0,0,10,6">
            <Grid Height="30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="110" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource HeaderButton}" Command="{Binding SortCommand}" CommandParameter="Name">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="NAME" FontWeight="SemiBold" />
                        <c:IconView Data="{StaticResource Icon.Sort}" Width="11" Height="11" Margin="5,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="1" Style="{StaticResource HeaderButton}" Command="{Binding SortCommand}" CommandParameter="Pid">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="PID" FontWeight="SemiBold" />
                        <c:IconView Data="{StaticResource Icon.Sort}" Width="11" Height="11" Margin="5,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="2" Style="{StaticResource HeaderButton}" Command="{Binding SortCommand}" CommandParameter="Cpu">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="CPU" FontWeight="SemiBold" />
                        <c:IconView Data="{StaticResource Icon.Sort}" Width="11" Height="11" Margin="5,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="3" Style="{StaticResource HeaderButton}" Command="{Binding SortCommand}" CommandParameter="Memory">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="MEMORY" FontWeight="SemiBold" />
                        <c:IconView Data="{StaticResource Icon.Sort}" Width="11" Height="11" Margin="5,0,0,0" />
                    </StackPanel>
                </Button>
                <TextBlock Grid.Column="4" Text="TYPE" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Brush.TextSecondary}" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="6">
            <Grid>
                <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding RowsView}" SelectedItem="{Binding Selected}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="38">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontWeight="Medium" />
                                <TextBlock Grid.Column="1" Text="{Binding Pid}" VerticalAlignment="Center" Foreground="{StaticResource Brush.TextSecondary}" FontFamily="{StaticResource Font.Mono}" FontSize="12" />
                                <TextBlock Grid.Column="2" Text="{Binding CpuText}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{Binding MemoryText}" VerticalAlignment="Center" />
                                <Border Grid.Column="4" Style="{StaticResource Badge}" Background="{Binding TagTone, Converter={StaticResource ToneSoftBrush}}"
                                        Visibility="{Binding HasTag, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <c:IconView Data="{StaticResource Icon.Lock}" Width="10" Height="10" Margin="0,0,4,0" Foreground="{Binding TagTone, Converter={StaticResource ToneBrush}}" />
                                        <TextBlock Text="{Binding Tag}" Style="{StaticResource Badge.Text}" Foreground="{Binding TagTone, Converter={StaticResource ToneBrush}}" />
                                    </StackPanel>
                                </Border>
                                <Button Grid.Column="5" Padding="10,4" HorizontalAlignment="Right" FontSize="12"
                                        Command="{Binding DataContext.EndProcessCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource Btn.Ghost}">
                                            <Setter Property="Content" Value="End task" />
                                            <Setter Property="Foreground" Value="{StaticResource Brush.Danger}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CanEnd}" Value="False">
                                                    <Setter Property="Content" Value="Protected" />
                                                    <Setter Property="Foreground" Value="{StaticResource Brush.TextTertiary}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Visibility="{Binding IsLoaded, Converter={StaticResource InverseBoolToVisibility}}" Margin="8">
                    <c:SkeletonBlock Height="30" Margin="0,0,0,8" />
                    <c:SkeletonBlock Height="30" Margin="0,0,0,8" />
                    <c:SkeletonBlock Height="30" Margin="0,0,0,8" />
                    <c:SkeletonBlock Height="30" Margin="0,0,0,8" />
                    <c:SkeletonBlock Height="30" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource Card.Inset}" Margin="0,12,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal" Visibility="{Binding Selected, Converter={StaticResource NullToVisibility}}">
                    <c:IconView Data="{StaticResource Icon.Folder}" Width="14" Height="14" Foreground="{StaticResource Brush.TextTertiary}" />
                    <TextBlock Text="{Binding Selected.Path}" Style="{StaticResource Text.Mono}" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Style="{StaticResource Text.Caption}" Visibility="{Binding Selected, Converter={StaticResource InverseNullToVisibility}}"
                           Text="SYSTEM and PROTECTED processes belong to Windows and cannot be ended here. Select a process to see its location." />
            </Grid>
        </Border>
    </Grid>
</UserControl>
