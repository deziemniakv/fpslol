<UserControl x:Class="FpsLol.Views.Pages.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:FpsLol.Controls">
    <UserControl.Resources>
        <Style x:Key="StatLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
            <Setter Property="Foreground" Value="{StaticResource Brush.TextTertiary}" />
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="InfoRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer Style="{StaticResource PageScroll}">
        <StackPanel MaxWidth="1280">
            <!-- Header -->
            <Grid Margin="0,0,0,22">
                <StackPanel>
                    <TextBlock Text="Performance status" Style="{StaticResource Text.H1}" />
                    <TextBlock Text="{Binding WindowsText}" Style="{StaticResource Text.Secondary}" Margin="0,4,0,0" />
                </StackPanel>
                <Button Style="{StaticResource Btn.Glass}" Command="{Binding RescanCommand}" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <c:IconView Data="{StaticResource Icon.Refresh}" Width="14" Height="14" Margin="0,0,8,0" />
                        <TextBlock Text="Rescan" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Row 1: score + gaming status -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.35*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Padding="28,26">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Command="{Binding ShowScoreDetailsCommand}" Cursor="Hand" ToolTip="View detailed analysis" FocusVisualStyle="{x:Null}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid x:Name="G" Width="176" Height="176" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                                        <Grid.RenderTransform>
                                            <ScaleTransform x:Name="S" />
                                        </Grid.RenderTransform>
                                        <ContentPresenter />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="S" Storyboard.TargetProperty="ScaleX" To="1.03" Duration="0:0:0.18" />
                                                        <DoubleAnimation Storyboard.TargetName="S" Storyboard.TargetProperty="ScaleY" To="1.03" Duration="0:0:0.18" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="S" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.22" />
                                                        <DoubleAnimation Storyboard.TargetName="S" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.22" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.ExitActions>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <Grid>
                                <c:ScoreRing Value="{Binding Score}" Thickness="11" />
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding ScoreLoading, Converter={StaticResource InverseBoolToVisibility}}">
                                    <TextBlock Text="{Binding Score}" Style="{StaticResource Text.Display}" HorizontalAlignment="Center" />
                                    <TextBlock Text="/ 100" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" Margin="0,-6,0,0" />
                                </StackPanel>
                                <c:Spinner Width="28" Height="28" Visibility="{Binding ScoreLoading, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                        </Button>
                        <StackPanel Grid.Column="1" Margin="30,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="System score" Style="{StaticResource Text.Overline}" />
                            <TextBlock Text="{Binding ScoreHeadline}" Style="{StaticResource Text.H2}" FontSize="20" Margin="0,6,0,0" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource Brush.Warning}" Margin="0,0,8,0" VerticalAlignment="Center"
                                         Visibility="{Binding AvailableCount, Converter={StaticResource CountToVisibility}}" />
                                <Ellipse Width="7" Height="7" Fill="{StaticResource Brush.Success}" Margin="0,0,8,0" VerticalAlignment="Center"
                                         Visibility="{Binding AvailableCount, Converter={StaticResource InverseCountToVisibility}}" />
                                <TextBlock Text="{Binding AvailableText}" Style="{StaticResource Text.Secondary}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                                <Button Style="{StaticResource Btn.Primary}" Command="{Binding OptimizeNowCommand}" Padding="20,10">
                                    <StackPanel Orientation="Horizontal">
                                        <c:IconView Data="{StaticResource Icon.Zap}" Width="15" Height="15" Margin="0,0,8,0" />
                                        <TextBlock Text="Optimize now" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource Btn.Glass}" Content="View analysis" Command="{Binding ShowScoreDetailsCommand}" Margin="10,0,0,0" Padding="18,10" />
                            </StackPanel>
                            <TextBlock Text="{Binding LastScanText}" Style="{StaticResource Text.Caption}" Margin="0,12,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Gaming status" Style="{StaticResource Text.Overline}" Margin="0,0,0,16" />
                        <ItemsControl ItemsSource="{Binding GamingStatus}" ItemTemplate="{StaticResource StatusRowTemplate}" />
                        <StackPanel Visibility="{Binding ScoreLoading, Converter={StaticResource BoolToVisibility}}">
                            <c:SkeletonBlock Height="28" Margin="0,0,0,12" />
                            <c:SkeletonBlock Height="28" Margin="0,0,0,12" />
                            <c:SkeletonBlock Height="28" Margin="0,0,0,12" />
                            <c:SkeletonBlock Height="28" Margin="0,0,0,12" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Row 2: CPU / GPU / RAM -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- CPU -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource IconTile}">
                                <c:IconView Data="{StaticResource Icon.Cpu}" Width="17" Height="17" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Processor" Style="{StaticResource Text.Overline}" />
                                <TextBlock Text="{Binding HardwareInfo.CpuName, FallbackValue=Detecting…}" FontWeight="Medium" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                                           ToolTip="{Binding HardwareInfo.CpuName}" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <TextBlock Text="{Binding CpuUsageText}" Style="{StaticResource Text.Metric}" />
                            <TextBlock Text="usage" Style="{StaticResource Text.Caption}" VerticalAlignment="Bottom" Margin="8,0,0,7" />
                        </StackPanel>
                        <c:Sparkline Values="{Binding CpuHistory}" Stroke="{StaticResource Brush.SeriesCpu}" Height="54" Margin="0,10,0,14" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Clock" Style="{StaticResource StatLabel}" />
                                <TextBlock Text="{Binding CpuClockText}" Style="{StaticResource StatValue}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Temperature" Style="{StaticResource StatLabel}" />
                                <TextBlock Text="{Binding CpuTempText}" Style="{StaticResource StatValue}"
                                           ToolTip="Windows does not provide a driver-free CPU die temperature. FPS.LOL does not install kernel drivers, so N/A is shown instead of a guessed value." />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Cores" Style="{StaticResource StatLabel}" />
                                <TextBlock Text="{Binding CpuDetail, FallbackValue=N/A}" Style="{StaticResource StatValue}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- GPU -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource IconTile}">
                                <c:IconView Data="{StaticResource Icon.Monitor}" Width="17" Height="17" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Graphics" Style="{StaticResource Text.Overline}" />
                                <TextBlock Text="{Binding GpuName}" FontWeight="Medium" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" ToolTip="{Binding GpuDetail}" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <TextBlock Text="{Binding GpuUsageText}" Style="{StaticResource Text.Metric}" />
                            <TextBlock Text="usage" Style="{StaticResource Text.Caption}" VerticalAlignment="Bottom" Margin="8,0,0,7" />
                        </StackPanel>
                        <c:Sparkline Values="{Binding GpuHistory}" Stroke="{StaticResource Brush.SeriesGpu}" Height="54" Margin="0,10,0,14" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="1.4*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Temperature" Style="{StaticResource StatLabel}" />
                                <TextBlock Text="{Binding GpuTempText}" Style="{StaticResource StatValue}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="VRAM" Style="{StaticResource StatLabel}" />
                                <TextBlock Text="{Binding VramText}" Style="{StaticResource StatValue}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- RAM -->
                <Border Grid.Column="4" Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource IconTile}">
                                <c:IconView Data="{StaticResource Icon.Memory}" Width="17" Height="17" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Memory" Style="{StaticResource Text.Overline}" />
                                <TextBlock Text="{Binding RamDetail}" FontWeight="Medium" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <TextBlock Text="{Binding RamUsageText}" Style="{StaticResource Text.Metric}" />
                            <TextBlock Text="in use" Style="{StaticResource Text.Caption}" VerticalAlignment="Bottom" Margin="8,0,0,7" />
                        </StackPanel>
                        <c:Sparkline Values="{Binding RamHistory}" Stroke="{StaticResource Brush.SeriesRam}" Height="54" Margin="0,10,0,14" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Used" Style="{StaticResource StatLabel}" />
                                <TextBlock Text="{Binding RamUsedText}" Style="{StaticResource StatValue}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Available" Style="{StaticResource StatLabel}" />
                                <TextBlock Text="{Binding RamAvailableText}" Style="{StaticResource StatValue}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Row 3: system + hardware -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="1.6*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="System" Style="{StaticResource Text.Overline}" Margin="0,0,0,16" />
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="Uptime" Style="{StaticResource StatLabel}" />
                                <TextBlock Text="{Binding UptimeText}" Style="{StaticResource StatValue}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="Processes" Style="{StaticResource StatLabel}" />
                                <TextBlock Text="{Binding ProcessCountText}" Style="{StaticResource StatValue}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Startup apps" Style="{StaticResource StatLabel}" />
                                <TextBlock Text="{Binding StartupAppsText}" Style="{StaticResource StatValue}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Windows" Style="{StaticResource StatLabel}" />
                                <TextBlock Text="{Binding WindowsText}" Style="{StaticResource StatValue}" ToolTip="{Binding WindowsText}" />
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <Grid>
                        <StackPanel Visibility="{Binding HardwareLoading, Converter={StaticResource InverseBoolToVisibility}}">
                            <TextBlock Text="Hardware" Style="{StaticResource Text.Overline}" Margin="0,0,0,16" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Motherboard" Style="{StaticResource StatLabel}" />
                                    <TextBlock Text="{Binding HardwareInfo.Motherboard}" Style="{StaticResource StatValue}" Margin="0,3,0,14" />
                                    <TextBlock Text="BIOS" Style="{StaticResource StatLabel}" />
                                    <TextBlock Text="{Binding HardwareInfo.Bios}" Style="{StaticResource StatValue}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Storage" Style="{StaticResource StatLabel}" />
                                    <TextBlock Text="{Binding StorageText}" Style="{StaticResource StatValue}" TextWrapping="Wrap" Margin="0,3,0,14" />
                                    <TextBlock Text="Network adapter" Style="{StaticResource StatLabel}" />
                                    <TextBlock Text="{Binding HardwareInfo.NetworkAdapter}" Style="{StaticResource StatValue}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                        <StackPanel Visibility="{Binding HardwareLoading, Converter={StaticResource BoolToVisibility}}">
                            <c:SkeletonBlock Width="90" Margin="0,0,0,18" HorizontalAlignment="Left" />
                            <c:SkeletonBlock Margin="0,0,0,12" />
                            <c:SkeletonBlock Margin="0,0,120,12" />
                            <c:SkeletonBlock Margin="0,0,60,12" />
                            <c:SkeletonBlock Margin="0,0,200,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
