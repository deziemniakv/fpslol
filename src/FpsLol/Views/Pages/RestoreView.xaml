<UserControl x:Class="FpsLol.Views.Pages.RestoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:FpsLol.Controls">
    <ScrollViewer Style="{StaticResource PageScroll}">
        <StackPanel MaxWidth="1100">
            <Grid Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="Restore Center" Style="{StaticResource Text.H1}" />
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Secondary}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource Btn.Ghost}" Command="{Binding OpenSystemRestoreCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Windows System Restore" />
                            <c:IconView Data="{StaticResource Icon.External}" Width="12" Height="12" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Toolbar -->
            <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,14">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock FontWeight="SemiBold" VerticalAlignment="Center"><Run Text="{Binding ActiveCount, Mode=OneWay}" /><Run Text=" active changes" /></TextBlock>
                        <Rectangle Width="1" Height="18" Fill="{StaticResource Brush.Divider}" Margin="16,0" />
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowRestored}" />
                        <TextBlock Text="Show restored" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Brush.TextSecondary}" />
                        <Button Style="{StaticResource Btn.Ghost}" Content="Clear restored" Command="{Binding ClearRestoredCommand}" Margin="10,0,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <c:Spinner Width="16" Height="16" Margin="0,0,12,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                        <Button Style="{StaticResource Btn.Glass}" Command="{Binding RestoreSelectedCommand}" Margin="0,0,8,0">
                            <TextBlock><Run Text="Restore selected (" /><Run Text="{Binding SelectedCount, Mode=OneWay}" /><Run Text=")" /></TextBlock>
                        </Button>
                        <Button Style="{StaticResource Btn.Primary}" Command="{Binding RestoreAllCommand}">
                            <StackPanel Orientation="Horizontal">
                                <c:IconView Data="{StaticResource Icon.RotateCcw}" Width="14" Height="14" Margin="0,0,8,0" />
                                <TextBlock Text="Restore all" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Empty state -->
            <Border Style="{StaticResource Card}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                <StackPanel HorizontalAlignment="Center" Margin="0,30">
                    <c:IconView Data="{StaticResource Icon.History}" Width="34" Height="34" Foreground="{StaticResource Brush.TextTertiary}" />
                    <TextBlock Text="{Binding EmptyTitle}" Style="{StaticResource Text.H2}" HorizontalAlignment="Center" Margin="0,12,0,0" />
                    <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Text.Secondary}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding RowsView}">
                <ItemsControl.GroupStyle>
                    <GroupStyle HeaderTemplate="{StaticResource GroupHeaderTemplate}" />
                </ItemsControl.GroupStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="18,14" Margin="0,0,0,8">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource Card}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Restored}" Value="True">
                                            <Setter Property="Opacity" Value="0.55" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="52" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" IsEnabled="{Binding Restored, Converter={StaticResource InverseBool}}" />
                                <TextBlock Grid.Column="1" Text="{Binding Time}" Style="{StaticResource Text.Mono}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="2" Margin="0,0,16,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                        <Border Style="{StaticResource Badge}" Margin="10,0,0,0">
                                            <TextBlock Text="{Binding Category}" Style="{StaticResource Badge.Text}" />
                                        </Border>
                                        <Border Style="{StaticResource Badge}" Margin="6,0,0,0" Visibility="{Binding ShowAdmin, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="ADMIN" Style="{StaticResource Badge.Text}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Margin="0,4,0,0" FontSize="12.5">
                                        <Run Text="Changed: " Foreground="{StaticResource Brush.TextTertiary}" /><Run Text="{Binding Change, Mode=OneWay}" Foreground="{StaticResource Brush.TextSecondary}" />
                                    </TextBlock>
                                </StackPanel>
                                <Grid Grid.Column="3" VerticalAlignment="Center">
                                    <Button Style="{StaticResource Btn.Glass}" Padding="14,6" Visibility="{Binding Restored, Converter={StaticResource InverseBoolToVisibility}}"
                                            Command="{Binding DataContext.RestoreOneCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal">
                                            <c:IconView Data="{StaticResource Icon.RotateCcw}" Width="13" Height="13" Margin="0,0,6,0" />
                                            <TextBlock Text="RESTORE" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Text="{Binding RestoredText}" Style="{StaticResource Text.Caption}" Visibility="{Binding Restored, Converter={StaticResource BoolToVisibility}}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Backups -->
            <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Configuration backups" Style="{StaticResource Text.H3}" />
                            <TextBlock Text="Written automatically before every set of changes. Independent from the history above and from Windows System Restore." Style="{StaticResource Text.Caption}" Margin="0,3,0,0" />
                        </StackPanel>
                        <Button Style="{StaticResource Btn.Ghost}" Command="{Binding OpenBackupsFolderCommand}" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <StackPanel Orientation="Horizontal">
                                <c:IconView Data="{StaticResource Icon.Folder}" Width="14" Height="14" Margin="0,0,6,0" />
                                <TextBlock Text="Open folder" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock Text="No backups yet." Style="{StaticResource Text.Caption}" Visibility="{Binding HasBackups, Converter={StaticResource InverseBoolToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding Backups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card.Inset}" Margin="0,0,0,6" Padding="14,9">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Timestamp, StringFormat=yyyy-MM-dd HH:mm:ss}" Style="{StaticResource Text.Mono}" />
                                            <TextBlock Text="{Binding Label}" Margin="16,0,0,0" FontWeight="Medium" />
                                            <TextBlock Style="{StaticResource Text.Caption}" Margin="10,1,0,0"><Run Text="{Binding Items, Mode=OneWay}" /><Run Text=" settings" /></TextBlock>
                                        </StackPanel>
                                        <Button Style="{StaticResource Btn.Ghost}" Content="Restore" HorizontalAlignment="Right"
                                                Command="{Binding DataContext.RestoreBackupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
