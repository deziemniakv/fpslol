<Window x:Class="FpsLol.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:FpsLol.Controls"
        xmlns:vm="clr-namespace:FpsLol.ViewModels"
        xmlns:svc="clr-namespace:FpsLol.Services"
        xmlns:pages="clr-namespace:FpsLol.Views.Pages"
        xmlns:dialogs="clr-namespace:FpsLol.Views.Dialogs"
        xmlns:views="clr-namespace:FpsLol.Views"
        Title="FPS.LOL" Width="1340" Height="860" MinWidth="1080" MinHeight="700"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="Transparent" Icon="/Assets/fpslol.ico"
        FontFamily="{StaticResource Font.Main}" FontSize="13" Foreground="{StaticResource Brush.Text}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="-1" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Pages -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><pages:DashboardView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:PerformanceViewModel}"><pages:PerformanceView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:OptimizeViewModel}"><pages:OptimizeView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:TweaksViewModel}"><pages:TweaksView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:GamingViewModel}"><pages:GamingView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:PowerViewModel}"><pages:PowerView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:NetworkViewModel}"><pages:NetworkView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProcessesViewModel}"><pages:ProcessesView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:StartupViewModel}"><pages:StartupView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:CleanupViewModel}"><pages:CleanupView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:RestoreViewModel}"><pages:RestoreView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><pages:SettingsView /></DataTemplate>

        <!-- Dialogs -->
        <DataTemplate DataType="{x:Type svc:ConfirmDialogViewModel}"><dialogs:ConfirmDialogView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ScoreDetailsDialogViewModel}"><dialogs:ScoreDetailsDialogView /></DataTemplate>
    </Window.Resources>

    <Grid x:Name="Root">
        <!-- ============================================================ Backdrop layers -->
        <Rectangle Fill="{DynamicResource Brush.WindowTint}" />
        <Canvas x:Name="Ambient" IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse x:Name="LightA" Width="980" Height="760" Canvas.Left="-260" Canvas.Top="-380" Fill="{StaticResource Brush.AmbientLight}">
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="LightAShift" />
                </Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="LightB" Width="900" Height="900" Canvas.Left="760" Canvas.Top="380" Fill="{StaticResource Brush.AmbientCool}">
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="LightBShift" />
                </Ellipse.RenderTransform>
            </Ellipse>
        </Canvas>

        <Grid IsEnabled="{Binding IsShellEnabled}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="244" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ======================================================== Sidebar -->
            <Border Background="{DynamicResource Brush.Sidebar}" BorderBrush="{StaticResource Brush.Divider}" BorderThickness="0,0,1,0">
                <Grid Margin="14,0,14,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="52" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Logo -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,6,0,0">
                        <TextBlock Text="FPS" FontFamily="{StaticResource Font.Display}" FontSize="19" FontWeight="Bold" />
                        <TextBlock Text=".LOL" FontFamily="{StaticResource Font.Display}" FontSize="19" FontWeight="Bold" Foreground="{StaticResource Brush.TextTertiary}" />
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="Optimize. Play. Perform." Style="{StaticResource Text.Caption}" Margin="11,0,0,18" />

                    <!-- Navigation -->
                    <ListBox Grid.Row="2" ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNav}"
                             ItemContainerStyle="{StaticResource NavItem}" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" FocusVisualStyle="{x:Null}">
                        <ListBox.Template>
                            <ControlTemplate TargetType="ListBox">
                                <ScrollViewer Focusable="False">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ListBox.Template>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <c:IconView Data="{Binding Icon, Converter={StaticResource ResourceKey}}" Width="17" Height="17" />
                                    <TextBlock Text="{Binding Title}" Margin="12,0,0,0" FontSize="13.5" FontWeight="Medium" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- System footer -->
                    <Border Grid.Row="3" Style="{StaticResource Card.Inset}" Padding="14,12" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding WindowsVersion}" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.TextSecondary}" TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <c:IconView Data="{StaticResource Icon.ShieldCheck}" Width="13" Height="13" Foreground="{StaticResource Brush.Success}"
                                            Visibility="{Binding IsElevated, Converter={StaticResource BoolToVisibility}}" />
                                <c:IconView Data="{StaticResource Icon.User}" Width="13" Height="13" Foreground="{StaticResource Brush.TextSecondary}"
                                            Visibility="{Binding IsElevated, Converter={StaticResource InverseBoolToVisibility}}" />
                                <TextBlock Text="{Binding PrivilegeText}" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.TextSecondary}" Margin="6,0,0,0" />
                            </StackPanel>
                            <Button Style="{StaticResource Btn.Link}" Command="{Binding RestartAsAdminCommand}" Margin="0,6,0,0" HorizontalAlignment="Left"
                                    Visibility="{Binding IsElevated, Converter={StaticResource InverseBoolToVisibility}}">
                                <TextBlock Text="Restart as administrator" TextDecorations="Underline" FontSize="11.5" />
                            </Button>
                            <TextBlock Text="{Binding AppVersion}" Style="{StaticResource Text.Caption}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ======================================================== Content -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="52" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Title bar (drag area comes from WindowChrome) -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0">
                    <Button Style="{StaticResource Btn.Caption}" Click="OnMinimize" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Minimize">
                        <c:IconView Data="{StaticResource Icon.Minus}" Width="15" Height="15" StrokeThickness="1.6" />
                    </Button>
                    <Button Style="{StaticResource Btn.Caption}" Click="OnMaximize" WindowChrome.IsHitTestVisibleInChrome="True" x:Name="MaximizeButton" ToolTip="Maximize">
                        <c:IconView x:Name="MaximizeIcon" Data="{StaticResource Icon.Square}" Width="13" Height="13" StrokeThickness="1.8" />
                    </Button>
                    <Button Style="{StaticResource Btn.CaptionClose}" Click="OnClose" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Close">
                        <c:IconView Data="{StaticResource Icon.X}" Width="15" Height="15" StrokeThickness="1.6" />
                    </Button>
                </StackPanel>

                <c:PageHost Grid.Row="1" Content="{Binding CurrentPage}" Focusable="False" />
            </Grid>
        </Grid>

        <!-- ============================================================ Toasts -->
        <ItemsControl ItemsSource="{Binding Toasts}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,20" Width="370" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type svc:Toast}">
                    <Border Background="{StaticResource Brush.GlassStrong}" BorderBrush="{StaticResource Brush.PopupBorder}" BorderThickness="1" CornerRadius="14"
                            Padding="14,12" Margin="0,8,0,0" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <TranslateTransform X="24" />
                        </Border.RenderTransform>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="28" ShadowDepth="8" Direction="270" Opacity="0.45" Color="Black" />
                        </Border.Effect>
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.22" />
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="24" To="0" Duration="0:0:0.28">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <c:IconView Data="{Binding Icon, Converter={StaticResource ResourceKey}}" Width="18" Height="18" VerticalAlignment="Top" Margin="0,1,12,0"
                                        Foreground="{Binding Tone, Converter={StaticResource ToneBrush}}" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Secondary}" FontSize="12.5" Margin="0,3,0,0" />
                                <Button Style="{StaticResource Btn.Link}" Command="{Binding OpenDetailsCommand}" Margin="0,6,0,0" HorizontalAlignment="Left"
                                        Visibility="{Binding HasDetails, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Show details" TextDecorations="Underline" />
                                </Button>
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource Btn.Icon}" Width="26" Height="26" Margin="8,-4,-6,0" VerticalAlignment="Top" Command="{Binding DismissCommand}">
                                <c:IconView Data="{StaticResource Icon.X}" Width="13" Height="13" />
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ============================================================ Dialog layer -->
        <Grid Visibility="{Binding Dialog, Converter={StaticResource NullToVisibility}}">
            <Rectangle Fill="{StaticResource Brush.Scrim}" />
            <c:PageHost Content="{Binding Dialog}" Offset="16" ScaleFrom="0.96" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40" />
        </Grid>

        <!-- ============================================================ First run -->
        <Grid Visibility="{Binding IsFirstRunVisible, Converter={StaticResource BoolToVisibility}}">
            <Rectangle Fill="{DynamicResource Brush.WindowTint}" />
            <Rectangle Fill="#B30A0A0C" />
            <views:FirstRunView DataContext="{Binding FirstRun}" />
        </Grid>
    </Grid>
</Window>
