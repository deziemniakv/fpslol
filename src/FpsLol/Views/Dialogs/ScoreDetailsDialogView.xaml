<UserControl x:Class="FpsLol.Views.Dialogs.ScoreDetailsDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:FpsLol.Controls">
    <Border Width="620" Background="{StaticResource Brush.GlassStrong}" BorderBrush="{StaticResource Brush.PopupBorder}" BorderThickness="1" CornerRadius="22" Padding="28,26">
        <Border.Effect>
            <DropShadowEffect BlurRadius="60" ShadowDepth="18" Direction="270" Opacity="0.55" Color="Black" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Width="86" Height="86">
                    <c:ScoreRing Value="{Binding Score}" Thickness="7" />
                    <TextBlock Text="{Binding Score}" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
                <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="System score analysis" Style="{StaticResource Text.Overline}" />
                    <TextBlock Text="{Binding Headline}" Style="{StaticResource Text.H2}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Caption}" Margin="0,6,0,0" />
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1" MaxHeight="420" Margin="0,20,0,0" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card.Inset}" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="8" Height="8" Fill="{Binding Tone, Converter={StaticResource ToneBrush}}" VerticalAlignment="Top" Margin="0,5,12,0" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,3,0,0" />
                                        <TextBlock Text="{Binding Advice}" Style="{StaticResource Text.Caption}" Margin="0,3,0,0"
                                                   Visibility="{Binding Advice, Converter={StaticResource NullToVisibility}}" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Style="{StaticResource Badge}" VerticalAlignment="Top" Background="{Binding Tone, Converter={StaticResource ToneSoftBrush}}">
                                        <TextBlock Text="{Binding PointsText}" Style="{StaticResource Badge.Text}" Foreground="{Binding Tone, Converter={StaticResource ToneBrush}}" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="0,20,0,0">
                <TextBlock Text="The score is calculated only from settings detected on this PC. Unsupported features are excluded." Style="{StaticResource Text.Caption}"
                           VerticalAlignment="Center" Margin="0,0,140,0" />
                <Button Style="{StaticResource Btn.Primary}" Content="Close" Command="{Binding ConfirmCommand}" IsDefault="True" IsCancel="True" HorizontalAlignment="Right" MinWidth="100" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
