<UserControl x:Class="FpsLol.Views.Dialogs.ConfirmDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:FpsLol.Controls">
    <Border Width="500" Background="{StaticResource Brush.GlassStrong}" BorderBrush="{StaticResource Brush.PopupBorder}" BorderThickness="1" CornerRadius="22" Padding="28,26">
        <Border.Effect>
            <DropShadowEffect BlurRadius="60" ShadowDepth="18" Direction="270" Opacity="0.55" Color="Black" />
        </Border.Effect>
        <StackPanel>
            <Border Width="42" Height="42" CornerRadius="13" HorizontalAlignment="Left" Background="{Binding Tone, Converter={StaticResource ToneSoftBrush}}">
                <c:IconView Data="{Binding Icon, Converter={StaticResource ResourceKey}}" Width="20" Height="20" Foreground="{Binding Tone, Converter={StaticResource ToneBrush}}" />
            </Border>
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.H2}" FontSize="18" Margin="0,16,0,0" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Secondary}" Margin="0,8,0,0" />

            <Border Style="{StaticResource Card.Inset}" Margin="0,16,0,0" Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibility}}">
                <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="4" Height="4" Fill="{StaticResource Brush.TextTertiary}" VerticalAlignment="Top" Margin="0,7,0,0" HorizontalAlignment="Left" />
                                    <TextBlock Grid.Column="1" Text="{Binding}" FontSize="12.5" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <StackPanel Visibility="{Binding HasDetails, Converter={StaticResource BoolToVisibility}}" Margin="0,14,0,0">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource Btn.Link}" Command="{Binding ToggleDetailsCommand}">
                        <StackPanel Orientation="Horizontal">
                            <c:IconView Data="{StaticResource Icon.ChevronDown}" Width="13" Height="13" Margin="0,0,5,0" />
                            <TextBlock Text="Technical details" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Btn.Link}" Command="{Binding CopyDetailsCommand}" Margin="16,0,0,0"
                            Visibility="{Binding ShowDetails, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <c:IconView Data="{StaticResource Icon.Copy}" Width="12" Height="12" Margin="0,0,5,0" />
                            <TextBlock Text="Copy" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <Border Style="{StaticResource Card.Inset}" Margin="0,8,0,0" Visibility="{Binding ShowDetails, Converter={StaticResource BoolToVisibility}}">
                    <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <TextBox Text="{Binding Details, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0"
                                 FontFamily="{StaticResource Font.Mono}" FontSize="11.5" Foreground="{StaticResource Brush.TextSecondary}" TextWrapping="Wrap" />
                    </ScrollViewer>
                </Border>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button Style="{StaticResource Btn.Glass}" Content="{Binding CancelText}" Command="{Binding CancelCommand}" IsCancel="True" Margin="0,0,10,0"
                        Visibility="{Binding HasCancel, Converter={StaticResource BoolToVisibility}}" MinWidth="96" />
                <Button Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}" IsDefault="True" MinWidth="110">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Btn.Primary}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDanger}" Value="True">
                                    <Setter Property="Background" Value="#FFF19A9A" />
                                    <Setter Property="Foreground" Value="#FF1A0A0A" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
