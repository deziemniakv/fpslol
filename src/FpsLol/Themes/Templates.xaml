<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:FpsLol.Controls"
                    xmlns:items="clr-namespace:FpsLol.ViewModels.Items">

    <!-- ================================================================ Chip list (ListBox) -->
    <Style x:Key="ChipItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Margin" Value="0,0,6,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bg" CornerRadius="15" Padding="13,6" Background="#0AFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#16FFFFFF" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#FFF4F4F6" />
                            <Setter TargetName="Bg" Property="BorderBrush" Value="#FFF4F4F6" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.TextInverse}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ChipList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource ChipItem}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ItemsPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Selectable card list (e.g. DNS presets, profiles) -->
    <Style x:Key="CardItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" CornerRadius="12" Padding="14,11" Background="#07FFFFFF" BorderBrush="#10FFFFFF" BorderThickness="1">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#0FFFFFFF" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#18FFFFFF" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#55FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CardList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource CardItem}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ItemsPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================ Status pill (dot + text) -->
    <DataTemplate x:Key="StatusRowTemplate" DataType="{x:Type items:StatusItem}">
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource IconTile}" Width="30" Height="30" CornerRadius="9">
                <c:IconView Data="{Binding Icon, Converter={StaticResource ResourceKey}}" Width="15" Height="15" Foreground="{StaticResource Brush.TextSecondary}" />
            </Border>
            <TextBlock Grid.Column="1" Text="{Binding Label}" Margin="12,0,8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="7" Height="7" Fill="{Binding Tone, Converter={StaticResource ToneBrush}}" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Value}" Foreground="{StaticResource Brush.TextSecondary}" MaxWidth="230" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <!-- ================================================================ Tweak card -->
    <DataTemplate x:Key="TweakCardTemplate" DataType="{x:Type items:TweakItemViewModel}">
        <Border Style="{StaticResource Card}" Padding="20,18" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,24,0">
                    <WrapPanel>
                        <TextBlock Text="{Binding Name}" Style="{StaticResource Text.H3}" Margin="0,0,10,4" VerticalAlignment="Center" />
                        <Border Style="{StaticResource Badge}" Background="{Binding Risk, Converter={StaticResource ToneSoftBrush}}" Margin="0,0,6,4">
                            <TextBlock Text="{Binding RiskText}" Style="{StaticResource Badge.Text}" Foreground="{Binding Risk, Converter={StaticResource ToneBrush}}" />
                        </Border>
                        <Border Style="{StaticResource Badge}" Margin="0,0,6,4">
                            <TextBlock Text="{Binding CategoryName}" Style="{StaticResource Badge.Text}" />
                        </Border>
                        <Border Style="{StaticResource Badge}" Margin="0,0,6,4" Background="{StaticResource Brush.InfoSoft}"
                                Visibility="{Binding NeedsRestart, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding RestartText}" Style="{StaticResource Badge.Text}" Foreground="{StaticResource Brush.Info}" />
                        </Border>
                        <Border Style="{StaticResource Badge}" Margin="0,0,6,4" Visibility="{Binding ShowAdminBadge, Converter={StaticResource BoolToVisibility}}"
                                ToolTip="Administrator privileges required. Windows will ask for permission when you apply this change.">
                            <StackPanel Orientation="Horizontal">
                                <c:IconView Data="{StaticResource Icon.Shield}" Width="11" Height="11" Margin="0,0,4,0" Foreground="{StaticResource Brush.TextSecondary}" />
                                <TextBlock Text="ADMIN" Style="{StaticResource Badge.Text}" />
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                    <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Secondary}" Margin="0,4,0,0" MaxWidth="760" HorizontalAlignment="Left" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0" Visibility="{Binding IsSupported, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Current" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Current}" Margin="8,0,20,0" FontWeight="Medium" VerticalAlignment="Center" />
                        <TextBlock Text="Recommended" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Recommended}" Margin="8,0,0,0" FontWeight="Medium" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding UnsupportedReason}" Style="{StaticResource Text.Caption}" Margin="0,10,0,0"
                               Visibility="{Binding UnsupportedReason, Converter={StaticResource NullToVisibility}}" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" MinWidth="200">
                    <Border Style="{StaticResource Badge}" HorizontalAlignment="Right" Background="{Binding StatusTone, Converter={StaticResource ToneSoftBrush}}" Padding="10,4">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{Binding StatusTone, Converter={StaticResource ToneBrush}}" Margin="0,0,7,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding StatusText}" FontSize="11.5" FontWeight="SemiBold" Foreground="{Binding StatusTone, Converter={StaticResource ToneBrush}}" />
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                        <c:Spinner Width="16" Height="16" Margin="0,0,12,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                        <Button Style="{StaticResource Btn.Glass}" Content="Restore" Command="{Binding RestoreCommand}" Padding="14,7" Margin="0,0,8,0"
                                ToolTip="Restore the previous value (or reset to the Windows default)" />
                        <Button Style="{StaticResource Btn.Primary}" Content="Apply" Command="{Binding ApplyCommand}" Padding="16,7" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- Section overline used in grouped lists -->
    <DataTemplate x:Key="GroupHeaderTemplate">
        <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Overline}" Margin="4,14,0,10" />
    </DataTemplate>
</ResourceDictionary>
